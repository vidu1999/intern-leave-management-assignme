# ---------------------------------------------------------------------------
# LeaveManager - backend environment configuration
# Copy this file to `.env` and adjust the values for your machine.
#   Windows (PowerShell): Copy-Item .env.example .env
#   Windows (cmd):        copy .env.example .env
#   macOS / Linux:        cp .env.example .env
#
# Hosting platforms (Render / Railway / Fly / Docker) set these as dashboard
# environment variables instead of using a .env file - see docs/DEPLOYMENT.md
# ---------------------------------------------------------------------------

# HTTP port. Noisy hosts inject their own PORT; keep 5000 locally.
PORT=5000

# Interface to bind. 0.0.0.0 is required inside containers so the platform
# router can reach the process. Use 127.0.0.1 to keep it strictly local.
HOST=0.0.0.0

# development | production | test
NODE_ENV=development

# SQLite database file, relative to the `server/` directory
# (or an absolute path). The file is created by `npm run db:migrate`.
# In production point this at a persistent volume, e.g. /var/data/leave_manager.db
DATABASE_FILE=./data/leave_manager.db

# Comma separated list of browser origins allowed to call this API cross-origin.
# Same-origin requests (the SPA served by this same server) are always allowed.
# The Vite dev server runs on port 5173.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Optional: where the built React app lives (defaults to ../client/dist).
# When that folder exists the API also serves the web app -> one URL, one process.
# CLIENT_DIST=../client/dist

# Optional: maximum accepted JSON body size.
# JSON_BODY_LIMIT=100kb
