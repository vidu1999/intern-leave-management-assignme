# Dependencies
node_modules/
.pnp/
.pnp.js

# Environment configuration (never commit real secrets)
.env
.env.*
!.env.example

# SQLite database files (never commit data that may contain personal information)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
server/data/*
!server/data/.gitkeep

# Build output
dist/
build/
dist-ssr/
client/dist/

# Coverage / test artefacts
coverage/
*.lcov
.vitest/
playwright-report/
test-results/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Misc
.cache/
.tmp/
