# Base URL consumed by src/services/api.js.
# Leave it empty to use the Vite dev-server proxy (recommended for local
# development: the browser calls /api on port 5173 and Vite forwards to 5000).
#
# Set it explicitly when the API is served from a different origin, e.g.:
# VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_BASE_URL=

# Optional: where the Vite proxy forwards /api requests during `npm run dev`.
# VITE_PROXY_TARGET=http://127.0.0.1:5000
